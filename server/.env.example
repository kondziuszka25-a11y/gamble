# Server Environment Variables
PORT=3001
NODE_ENV=production

# Database Connection (Prisma)
# Default SQLite:
DATABASE_URL="file:./jackpot.db"

# Or PostgreSQL for production hosting (Railway, Supabase, Neon, Render):
# DATABASE_URL="postgresql://postgres:password@host:5432/jackpot?schema=public"

# Or MySQL:
# DATABASE_URL="mysql://root:password@host:3306/jackpot"

# JWT Authentication Secrets (Generate strong random strings in production!)
JWT_SECRET="change-this-to-a-very-long-and-secure-random-secret-key-12345"
JWT_REFRESH_SECRET="change-this-to-another-very-long-secure-refresh-key-67890"

# Allowed CORS client URL (Frontend origin, comma-separated if multiple)
CLIENT_URL="http://localhost:5173"
