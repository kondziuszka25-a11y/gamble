{
  "name": "gamble",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "vite",
    "server": "npm run dev --prefix server",
    "dev:all": "concurrently -n \"client,server\" -c \"magenta,cyan\" \"vite\" \"npm run dev --prefix server\"",
    "build": "tsc -b && vite build",
    "build:server": "npm run build --prefix server",
    "build:all": "npm run build && npm run build --prefix server",
    "start": "node server/dist/index.js",
    "postinstall": "npm install --prefix server --omit=dev",
    "db:seed": "npm run db:seed --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
